FROM registry.suse.com/bci/bci-base:15.6


ARG TARGETARCH          # filled by buildx (amd64 / arm64)
ARG K8S_VERSION=v1.31.0
ARG DOCTL_VERSION=1.114.0

# Cloud:Tools (s3cmd) — no SLE_15_SP6 build exists; SP5 rpm is noarch, works on 15.6
RUN zypper -n addrepo -G -f https://download.opensuse.org/repositories/Cloud:/Tools/SLE_15_SP5/Cloud:Tools.repo cloud-tools \
 && zypper -n --gpg-auto-import-keys ref \
 && zypper -n install --no-recommends \
      ca-certificates curl jq qemu-tools s3cmd python3 gzip tar \
 && zypper clean -a

# doctl static binary (arch-aware)
RUN curl -sfL "https://github.com/digitalocean/doctl/releases/download/v${DOCTL_VERSION}/doctl-${DOCTL_VERSION}-linux-${TARGETARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin doctl && chmod +x /usr/local/bin/doctl
 
 RUN curl -sfL "https://dl.k8s.io/release/${K8S_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl

COPY export-seedimages.sh /usr/local/bin/export-seedimages.sh
RUN chmod +x /usr/local/bin/export-seedimages.sh

ENTRYPOINT ["/usr/local/bin/export-seedimages.sh"]