ARG ELEMENTAL_CLI=ghcr.io/rancher/elemental-toolkit/elemental-cli:v2.1.1

FROM ${ELEMENTAL_CLI} AS elemental

FROM registry.suse.com/suse/sl-micro/6.2/baremetal-os-container:v2.3.1-8.118

# v2.x: binary lives at /usr/bin/elemental; /install-root no longer exists
COPY --from=elemental /usr/bin/elemental /usr/bin/elemental

# BIOS GRUB for DigitalOcean
RUN set -eu; \
    zypper --non-interactive install --no-recommends \
      grub2-i386-pc \
      e2fsprogs \
      parted \
      && zypper clean -a

COPY files/05_do-bios.yaml /system/oem/05_do-bios.yaml
COPY files/98_layout.env /system/oem/98_layout.env

RUN echo 'GRUB_ENTRY_NAME=elemental-devcloud' >> /etc/os-release

# Generates initrd + embedded GRUB/dracut/elemental config (replaces install-root)
RUN elemental init --force