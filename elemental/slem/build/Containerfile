# Build arg: match your Elemental CLI version (use latest stable)
ARG ELEMENTAL_CLI=ghcr.io/rancher/elemental-toolkit/elemental-cli:v2.1.1

FROM ${ELEMENTAL_CLI} AS elemental

FROM registry.suse.com/suse/sl-micro/6.0/baremetal-os-container:2.1.1-3.29

# elemental-cli + dependencies for image builds / install
COPY --from=elemental /elemental /usr/bin/elemental
COPY --from=elemental /install-root /

# --- BIOS boot support for DigitalOcean -------------------------------------
# The stock baremetal container ships EFI grub. DO custom images boot with
# SeaBIOS, so we need the i386-pc bootloader stack in the image.
RUN set -eu; \
    zypper --non-interactive install --no-recommends \
      grub2-i386-pc \
      grub2-snapper-plugin \
      e2fsprogs \
      parted \
      && zypper clean -a

# --- Serial console + DO defaults baked into the image ----------------------
COPY files/05_do-bios.yaml /system/oem/05_do-bios.yaml
COPY files/grub.default /usr/local/share/elemental/grub.default

# --- Persist /etc/default/grub across elemental upgrades --------------------
# Immutable root: mark the file so the persistent overlay keeps it.
COPY files/98_layout.env /system/oem/98_layout.env

# --- Branding ----------------------------------------------------------------
RUN echo 'GRUB_ENTRY_NAME=elemental-devcloud' >> /etc/os-release

# Required by elemental tooling
RUN elemental build-state || true

ENV ARCH=x86_64